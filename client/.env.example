# Environment configuration is now handled in src/config.js
# The API URL is automatically selected based on NODE_ENV
# 
# For production (NODE_ENV=production): https://ml-fno-prediction-server.onrender.com
# For development (NODE_ENV=development): http://localhost:8000
#
# No environment variables needed for deployment!
# REACT_APP_API_URL=https://your-app-name.onrender.com
# REACT_APP_API_URL=https://your-domain.com

# For local Docker deployment
REACT_APP_API_URL=http://localhost:8000

# For production, replace with your actual backend URL
# REACT_APP_API_URL=https://your-backend-domain.com
